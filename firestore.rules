rules_version = '2';

// ==========================================================
// Zanzibar — regole di sicurezza Firestore
// ----------------------------------------------------------
// - Chiunque può LEGGERE categorie, voci e foto (servono al menu pubblico).
// - Solo il proprietario può CREARE, MODIFICARE o ELIMINARE.
// - I dati salvati devono avere il formato giusto (nome, prezzo…).
//
// Sostituisci INSERISCI_UID_PROPRIETARIO con l'UID dell'utente
// creato in Firebase → Authentication → Utenti (colonna "UID utente").
// ==========================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.uid == "yFhDfv68LtUNvTAFlHcinSRU1mB2";
    }

    function isNumber(v) {
      return v is int || v is float;
    }

    // Categoria: nome, ordine, macro-sezione ("food" = Menù Food, "drink" = Drink),
    // nota facoltativa in fondo (es. "Supplementi € 0,50") e visibile/nascosta.
    function isValidCategory() {
      let c = request.resource.data;
      return c.keys().hasOnly(["name", "order", "section", "note", "visible", "createdAt", "updatedAt"])
        && c.name is string && c.name.size() > 0 && c.name.size() <= 60
        && isNumber(c.order)
        && c.section in ["food", "drink"]
        && c.note is string && c.note.size() <= 200
        && c.visible is bool;
    }

    // Un prezzo: etichetta facoltativa (es. "100 g") e valore in euro
    function isPrice(p) {
      return p is map
        && p.keys().hasOnly(["label", "value"])
        && p.label is string && p.label.size() <= 20
        && isNumber(p.value) && p.value >= 0 && p.value <= 100000;
    }

    // Voce: da 0 a 2 prezzi (0 = nessun prezzo mostrato), simbolo facoltativo (es. ★),
    // visibile/nascosta e "hasPhoto" (true se nella collezione photos c'è la sua foto).
    function isValidItem() {
      let v = request.resource.data;
      return v.keys().hasOnly(["name", "description", "prices", "symbol", "visible", "hasPhoto", "categoryId", "order", "createdAt", "updatedAt"])
        && v.name is string && v.name.size() > 0 && v.name.size() <= 120
        && v.description is string && v.description.size() <= 500
        && v.prices is list && v.prices.size() <= 2
        && (v.prices.size() < 1 || isPrice(v.prices[0]))
        && (v.prices.size() < 2 || isPrice(v.prices[1]))
        && v.symbol is string && v.symbol.size() <= 4
        && v.visible is bool
        && v.hasPhoto is bool
        && isNumber(v.order)
        // la categoria deve esistere (anche se creata nella stessa operazione)
        && v.categoryId is string
        && existsAfter(/databases/$(database)/documents/categories/$(v.categoryId));
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isOwner() && isValidCategory();
      allow delete: if isOwner();
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isOwner() && isValidItem();
      allow delete: if isOwner();
    }

    // Foto dei prodotti: un documento per voce, con lo stesso ID della voce.
    // "data" è la foto JPEG compressa dal pannello, scritta come testo (data URL base64).
    // 273100 caratteri = circa 200 KB di immagine JPEG.
    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(["data", "updatedAt"])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 273100
        && request.resource.data.data.matches('data:image/jpeg;base64,[A-Za-z0-9+/]+={0,2}');
      allow delete: if isOwner();
    }

    // Tutto il resto è chiuso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
