{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "GUIDA-FIREBASE.md",
      "README.md",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/admin", "destination": "/admin/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/admin/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|webp)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      }
    ]
  }
}
